# MCP broker URL used by Next.js API route handlers.
# This must point to the ecobe-mvp deployment, never directly to ecobe-engineclaude.
MCP_API_URL=http://localhost:3000

# Optional: tighten/loosen broker fetch timeout (milliseconds).
ECOBE_ENGINE_TIMEOUT_MS=12000

# Required for dashboard-side trace/replay/internal control-surface routes through the broker
ECOBE_INTERNAL_API_KEY=
MCP_INTERNAL_API_KEY=

# Required if the dashboard will initiate or proxy signed decision requests through the broker
DECISION_API_SIGNATURE_SECRET=

# Optional: override local runtime storage directory (dev only).
# Useful if you move this repo around (so .runtime data does not appear "missing").
CO2ROUTER_RUNTIME_DIR=

# Optional: browser override for MCP base URL (defaults to /api/ecobe proxy)
NEXT_PUBLIC_MCP_API_URL=

# Resend mail configuration
RESEND_API_KEY=
RESEND_FROM_CONTACT="CO2 Router <notifications@co2router.com>"
RESEND_FROM_ALERTS="CO2 Router Alerts <alerts@co2router.com>"
CONTACT_INBOX_EMAIL=affirmandthriveco@gmail.com
ALERT_INBOX_EMAIL=affirmandthriveco@gmail.com
CONTACT_SALES_EMAIL=sales@co2router.com
CONTACT_SUPPORT_EMAIL=support@co2router.com
CONTACT_SECURITY_EMAIL=security@co2router.com
